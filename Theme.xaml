<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================ Palette ============================ -->
    <Color x:Key="C.Bg">#FF070E1E</Color>
    <Color x:Key="C.Surface">#FF101A30</Color>
    <Color x:Key="C.Accent">#FF38BDF8</Color>
    <Color x:Key="C.Text">#FFE8F0FB</Color>

    <SolidColorBrush x:Key="B.Bg" Color="#FF070E1E" />
    <SolidColorBrush x:Key="B.Surface" Color="#B3101B33" />
    <SolidColorBrush x:Key="B.SurfaceSolid" Color="#FF0D1729" />
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="#66162542" />
    <SolidColorBrush x:Key="B.Card" Color="#8C0F1A31" />
    <SolidColorBrush x:Key="B.CardHover" Color="#A6152241" />
    <SolidColorBrush x:Key="B.Border" Color="#33A8CBFF" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="#5991C4FF" />
    <SolidColorBrush x:Key="B.Text" Color="#FFE8F0FB" />
    <SolidColorBrush x:Key="B.TextMuted" Color="#FF93A7C4" />
    <SolidColorBrush x:Key="B.TextFaint" Color="#FF63748F" />
    <SolidColorBrush x:Key="B.Accent" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="B.AccentDim" Color="#3338BDF8" />
    <SolidColorBrush x:Key="B.Good" Color="#FF34D399" />
    <SolidColorBrush x:Key="B.Warn" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="B.Bad" Color="#FFF87171" />

    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF38BDF8" Offset="0" />
        <GradientStop Color="#FF3B82F6" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================ Bases ============================ -->
    <Style TargetType="TextBlock" x:Key="T.Base">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}" />

    <Style TargetType="TextBlock" x:Key="T.H1" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.H2" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Muted" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="TextBlock" x:Key="T.Label" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================ Carte ============================ -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource B.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- ============================ Boutons ============================ -->
    <Style TargetType="Button" x:Key="Btn">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="#59182A4B"
                            BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#8C21386B" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#A62B4A87" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Primary" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="#FF04101F" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource B.AccentGrad}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Ghost" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#40203A6B" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton de barre de titre -->
    <Style TargetType="Button" x:Key="Btn.Chrome">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Btn.Close" BasedOn="{StaticResource Btn.Chrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Interrupteur ============================ -->
    <Style TargetType="ToggleButton" x:Key="Switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="46" Height="24" CornerRadius="12"
                                Background="#4014243D" BorderBrush="{StaticResource B.Border}"
                                BorderThickness="1" />
                        <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9"
                                Background="{StaticResource B.TextMuted}"
                                HorizontalAlignment="Left" Margin="4,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="KnobT" X="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource B.AccentGrad}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Knob" Property="Background" Value="#FF041020" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobT"
                                                         Storyboard.TargetProperty="X"
                                                         To="22" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobT"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Navigation laterale ============================ -->
    <Style TargetType="RadioButton" x:Key="NavItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="12,10" />
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" Background="{StaticResource B.Accent}"
                                Opacity="0" Margin="0,0,0,0" />
                        <ContentPresenter Margin="16,10,12,10" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33203A6B" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#5924406F" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Choix exclusif presente en pastille (portee de la surveillance) -->
    <Style TargetType="RadioButton" x:Key="Pill">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="#4014243D"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="18" Padding="16,8">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource B.BorderStrong}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource B.AccentGrad}" />
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{StaticResource B.Accent}" />
                            <Setter Property="Foreground" Value="#FF04101F" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Champ texte ============================ -->
    <Style TargetType="TextBox" x:Key="Input">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="#5908121F"
                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Case a cocher ============================ -->
    <Style TargetType="CheckBox" x:Key="Check">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                                Background="#5908121F" BorderBrush="{StaticResource B.BorderStrong}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Mark" Stretch="Uniform" Margin="3"
                                  Fill="#FF04101F" Opacity="0"
                                  Data="M 0,5 L 3.5,8.5 L 10,1" StrokeThickness="0" />
                        </Border>
                        <Border x:Name="Dash" Width="9" Height="2" CornerRadius="1"
                                Background="#FF04101F" Opacity="0"
                                Margin="-13,0,4,0" VerticalAlignment="Center" />
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Mark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Dash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource Check}" />

    <!-- ============================ Barre de defilement ============================ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#59A8CBFF" CornerRadius="4" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              Background="Transparent" BorderThickness="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              Background="Transparent" BorderThickness="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9" />
                            <Setter Property="Width" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Tableau ============================ -->
    <Style TargetType="DataGrid" x:Key="Grid.Dark">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="RowHeight" Value="30" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#4D0B1425" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                                <Path x:Name="Arrow" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Fill="{StaticResource B.Accent}" Opacity="0"
                                      Data="M 0,0 L 8,0 L 4,5 Z" />
                            </StackPanel>
                        </Border>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="4" CenterY="2.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter Property="Background" Value="#66142542" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3324406F" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#5938BDF8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Arborescence ============================ -->
    <Style TargetType="TreeView" x:Key="Tree.Dark">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="ToggleButton" x:Key="TreeExpander">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{StaticResource B.TextMuted}" Data="M 0,0 L 4.5,4 L 0,8 Z"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- Un Setter ne peut pas viser une transformation nommee dans un
                                 template : on remplace la transformation entiere. -->
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem" x:Key="Tree.Item">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                      Style="{StaticResource TreeExpander}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" />

                        <Border x:Name="Bd" Grid.Column="1" Background="Transparent"
                                CornerRadius="6" Padding="4,3">
                            <ContentPresenter ContentSource="Header" />
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2624406F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Liste simple ============================ -->
    <Style TargetType="ListBox" x:Key="List.Dark">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="ListBoxItem" x:Key="List.Item">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2624406F" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4038BDF8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem" BasedOn="{StaticResource List.Item}" />

    <!-- ============================ Menu contextuel ============================ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource B.SurfaceSolid}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Entree de menu simple (roles TopLevelItem et SubmenuItem).
        Les entrees qui portent des enfants ont un role different et un template
        dedie plus bas : sans Popup ni ItemsPresenter, un sous-menu ne s'ouvrirait
        jamais et la fleche de deploiement n'apparaitrait pas.
    -->
    <ControlTemplate x:Key="MenuItem.Simple" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4024406F" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Entree porteuse d'un sous-menu : fleche + popup des enfants. -->
    <ControlTemplate x:Key="MenuItem.Submenu" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" ContentSource="Header"
                                      VerticalAlignment="Center" />
                    <Path Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                          Fill="{StaticResource B.TextMuted}" Data="M 0,0 L 4.5,4 L 0,8 Z" />
                </Grid>
            </Border>

            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right" HorizontalOffset="-4" VerticalOffset="-6"
                   PopupAnimation="Fade">
                <Border Background="{StaticResource B.SurfaceSolid}"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="4">
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4024406F" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#5924406F" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template" Value="{StaticResource MenuItem.Simple}" />
        <Style.Triggers>
            <!-- Role vaut SubmenuHeader des que l'entree a des enfants. -->
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.Submenu}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.Submenu}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{StaticResource B.Border}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource B.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Liste deroulante ============================ -->
    <Style TargetType="ComboBox" x:Key="Combo">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="#5908121F"
                                            BorderBrush="{StaticResource B.Border}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="26" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Margin="10,6"
                                                              VerticalAlignment="Center" />
                                            <Path Grid.Column="1" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="{StaticResource B.TextMuted}"
                                                  Data="M 0,0 L 8,0 L 4,5 Z" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource B.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter
                                Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}" />
                        </ToggleButton>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{StaticResource B.SurfaceSolid}"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4024406F" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#4038BDF8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Info-bulle ============================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#F20B1526" BorderBrush="{StaticResource B.Border}"
                            BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="480">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
